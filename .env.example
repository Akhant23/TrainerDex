# Copy to .env.local and fill in. Only VITE_-prefixed values reach the browser,
# and only PUBLIC values may be VITE_: the Supabase URL + anon key and the Turnstile site key.
# Full walkthrough: docs/BACKEND.md

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=

# Secrets live in Supabase, set with `supabase secrets set` — never here:
#   TURNSTILE_SECRET_KEY, RATE_LIMIT_SALT, ALLOWED_ORIGINS
