# Copy to .env.local and fill in. Only VITE_-prefixed values reach the browser,
# and only public values (Supabase URL + anon key, Turnstile site key) may be VITE_.
# Used from Phase 5 (Poké Pager guestbook).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=

# Server-side only (Supabase Edge Function secrets — set with `supabase secrets set`, never here in VITE_):
# TURNSTILE_SECRET_KEY=
# RATE_LIMIT_SALT=
